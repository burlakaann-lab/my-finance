# Скопіюйте в .env і замініть значення своїми. Файл .env у git не потрапляє.
OLYA_PASSWORD=придумайте-пароль-від-12-символів
MARKO_PASSWORD=придумайте-інший-пароль-від-12-символів
TRACKER_SECRET_KEY=довгий-випадковий-рядок-від-32-символів
# Тільки для Vercel і для push_data.sh: безкоштовна база Neon Postgres (Vercel Marketplace).
# На Vercel цю змінну додає сама інтеграція. Для push_data.sh скопіюйте її з Vercel у .env.
DATABASE_URL=
