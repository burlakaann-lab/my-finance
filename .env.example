# Скопіюйте в .env і замініть значення своїми. Файл .env у git не потрапляє.
OLYA_PASSWORD=придумайте-пароль-від-12-символів
MARKO_PASSWORD=придумайте-інший-пароль-від-12-символів
TRACKER_SECRET_KEY=довгий-випадковий-рядок-від-32-символів
# Для Vercel і push_data.sh. DATABASE_URL лише на Vercel (додає інтеграція Neon), у локальний .env його не кладіть.
# SYNC_TOKEN однаковий на Vercel і в .env: довгий випадковий рядок від 32 символів.
SYNC_TOKEN=
# Тільки для push_data.sh: адреса сайту на Vercel.
SITE_URL=https://my-finance-eight-sigma.vercel.app
