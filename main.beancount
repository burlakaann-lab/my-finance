option "title" "Фінанси Олі"
option "operating_currency" "PLN"

2026-07-31 open Assets:Банк                  PLN
2026-07-31 open Equity:Початковий-Залишок    PLN

2026-07-31 open Income:Зарплата              PLN
2026-07-31 open Income:Інше                  PLN

2026-07-31 open Expenses:Житло               PLN
2026-07-31 open Expenses:Продукти            PLN
2026-07-31 open Expenses:Кафе                PLN
2026-07-31 open Expenses:Доставка-Їжі        PLN
2026-07-31 open Expenses:Транспорт           PLN
2026-07-31 open Expenses:Підписки            PLN
2026-07-31 open Expenses:Побут               PLN
2026-07-31 open Expenses:Спорт               PLN
2026-07-31 open Expenses:Телефон             PLN
2026-07-31 open Expenses:Без-Категорії       PLN

2026-07-31 * "Початковий залишок"
  Assets:Банк                 4500.00 PLN
  Equity:Початковий-Залишок  -4500.00 PLN

; Збережені запити. Місяць 10 неповний: дивіться дату останньої операції в запиті 2.

2026-07-31 query "Витрати-за-категоріями" "
  SELECT year AS \"рік\", month AS \"місяць\", account AS \"категорія\", sum(number) AS \"сума\"
  WHERE account ~ '^Expenses:'
  GROUP BY year, month, account
  ORDER BY year, month, account"

2026-07-31 query "Норма-заощаджень" "
  SELECT year AS \"рік\", month AS \"місяць\",
    -sum(number * decimal(account ~ '^Income:')) AS \"дохід\",
    sum(number * decimal(account ~ '^Expenses:')) AS \"витрати\",
    -sum(number) AS \"відкладено\",
    round(-sum(number) / -sum(number * decimal(account ~ '^Income:')) * 100, 1) AS \"відсоток\",
    max(date) AS \"остання_операція\"
  WHERE account ~ '^(Income|Expenses):'
  GROUP BY year, month
  ORDER BY year, month"

2026-07-31 query "Фіксовані-і-змінні" "
  SELECT year AS \"рік\", month AS \"місяць\",
    sum(number * decimal('fixed' IN tags)) AS \"фіксовані\",
    sum(number * decimal('fixed' NOT IN tags)) AS \"змінні\",
    sum(number) AS \"разом\"
  WHERE account ~ '^Expenses:'
  GROUP BY year, month
  ORDER BY year, month"

2026-07-31 query "Без-категорії" "
  SELECT year AS \"рік\", month AS \"місяць\", date AS \"дата\", narration AS \"опис\", number AS \"сума\"
  WHERE account = 'Expenses:Без-Категорії'
  ORDER BY date"

include "transactions.beancount"
